{
  "name": "cw-monorepo",
  "private": true,
  "scripts": {
    "dev":              "pnpm --filter @devoracle/app tauri dev",
    "dev:ringwise":     "pnpm --filter @ringwise/app tauri dev",
    "build":            "pnpm --filter @devoracle/app tauri build",
    "build:ringwise":   "pnpm --filter @ringwise/app tauri build",
    "dev:backend":      "pnpm --filter @cw/backend dev",
    "test:rust":        "cargo test --workspace",
    "lint:rust":        "cargo clippy --workspace -- -D warnings",
    "format:rust":      "cargo fmt --all"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
